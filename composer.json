{
    "name": "tylersriver/weekly-budget",
    "description": "Personal weekly and monthly budget tracker",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.14",
        "cycle/database": "^2.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.4",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@analyse",
            "@lint",
            "@test"
        ]
    }
}

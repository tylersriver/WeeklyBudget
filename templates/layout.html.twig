<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}WeeklyBudget{% endblock %}</title>

    <!-- DaisyUI + Tailwind CDN -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    {# Restore saved theme before first paint to prevent flash #}
    <script>
        (function() {
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    {% block head %}{% endblock %}
</head>
<body class="min-h-screen flex flex-col bg-base-200">

    {# ── Drawer wrapper (mobile sidebar) ── #}
    <div class="drawer">
        <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

        {# ── Drawer content (entire page) ── #}
        <div class="drawer-content flex flex-col">

            {# ── Navbar ── #}
            <div class="navbar bg-base-100 shadow-lg">
                {# Hamburger — visible on mobile only #}
                <div class="flex-none lg:hidden">
                    <label for="nav-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-6 w-6 stroke-current">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </label>
                </div>

                <div class="flex-1">
                    <a href="{{ url_for('dashboard') }}" class="btn btn-ghost text-xl font-bold">WeeklyBudget</a>
                </div>

                {# Desktop nav links — hidden on mobile #}
                <div class="hidden lg:flex">
                    <ul class="menu menu-horizontal px-1 gap-1">
                        <li><a href="{{ url_for('dashboard') }}">Dashboard</a></li>
                        <li><a href="{{ url_for('history') }}">History</a></li>
                        <li><a href="{{ url_for('budgets') }}">Budgets</a></li>
                    </ul>
                </div>

                {# Dark / light toggle #}
                <div class="flex-none">
                    <label class="swap swap-rotate ml-3" x-data="{
                        dark: localStorage.getItem('theme') === 'dark',
                        toggle() {
                            this.dark = !this.dark;
                            var theme = this.dark ? 'dark' : 'light';
                            localStorage.setItem('theme', theme);
                            document.documentElement.setAttribute('data-theme', theme);
                        }
                    }">
                        <input type="checkbox" :checked="dark" @change="toggle()" />
                        {# Sun icon #}
                        <svg class="swap-off w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" />
                        </svg>
                        {# Moon icon #}
                        <svg class="swap-on w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" />
                        </svg>
                    </label>
                </div>
            </div>

            {# ── Page content ── #}
            <main class="container mx-auto px-4 py-8 max-w-5xl flex-1">
                {% block content %}{% endblock %}
            </main>

            {# ── Footer ── #}
            <footer class="footer footer-center p-4 bg-base-300 text-base-content">
                <p>WeeklyBudget &copy; {{ "now"|date("Y") }} &mdash; <a class="link" href="https://github.com/tylersriver/WeeklyBudget" target="_blank">GitHub</a></p>
            </footer>

        </div>{# /drawer-content #}

        {# ── Drawer sidebar (mobile only) ── #}
        <div class="drawer-side">
            <label for="nav-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
            <ul class="menu bg-base-200 min-h-full w-64 p-4 text-base-content">
                <li class="menu-title text-lg font-bold mb-2">WeeklyBudget</li>
                <li><a href="{{ url_for('dashboard') }}">Dashboard</a></li>
                <li><a href="{{ url_for('history') }}">History</a></li>
                <li><a href="{{ url_for('budgets') }}">Budgets</a></li>
            </ul>
        </div>

    </div>{# /drawer #}

    {# ── Scripts ── #}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>

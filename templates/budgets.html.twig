{% extends "layout.html.twig" %}

{% block title %}Budgets — WeeklyBudget{% endblock %}

{% block content %}
<div class="space-y-6">

    {# ── Success toast ── #}
    {% if success is defined and success %}
    <div class="alert alert-success shadow-lg" x-data="{ show: true }" x-show="show"
         x-init="setTimeout(() => show = false, 3000)" x-transition>
        <span>Budget updated successfully.</span>
    </div>
    {% endif %}

    {# ── Current budgets ── #}
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Current Budgets</h2>
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for b in budgets %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ b.budgetType|capitalize }}</td>
                            <td>${{ b.amount|number_format(2) }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="text-center opacity-50 py-8">No budgets configured</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Update budget form ── #}
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Update Budget</h2>
            <form method="POST" action="{{ url_for('budgets.update') }}"
                  class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                <div class="form-control">
                    <label class="label"><span class="label-text">Type</span></label>
                    <select name="type" class="select select-bordered w-full" required>
                        {% for bt in budgetTypes %}
                            <option value="{{ bt.value }}">{{ bt.value|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-control">
                    <label class="label"><span class="label-text">New Amount</span></label>
                    <input name="amount" type="number" min="1" placeholder="Amount"
                           class="input input-bordered w-full" required />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>

</div>
{% endblock %}

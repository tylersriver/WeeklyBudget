{% extends "layout.html.twig" %}

{% block title %}Budget Estimator — WeeklyBudget{% endblock %}

{% block content %}
<div class="space-y-6">

    {# ── Monthly Summary ── #}
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Monthly Summary</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
                <div>
                    <p class="text-sm opacity-70">Total Income</p>
                    <p class="text-2xl font-bold text-success">${{ totalIncome|number_format(2) }}</p>
                </div>
                <div>
                    <p class="text-sm opacity-70">Total Expenses</p>
                    <p class="text-2xl font-bold text-error">${{ totalExpenses|number_format(2) }}</p>
                </div>
                <div>
                    <p class="text-sm opacity-70">Net Monthly</p>
                    <p class="text-2xl font-bold {{ netMonthly >= 0 ? 'text-success' : 'text-error' }}">
                        {{ netMonthly >= 0 ? '+' : '' }}${{ netMonthly|number_format(2) }}
                    </p>
                </div>
            </div>

            {% if totalExpenses > 0 %}
            <div class="divider"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span>Bills</span>
                        <span>${{ totalBills|number_format(2) }}</span>
                    </div>
                    <progress class="progress progress-error w-full"
                              value="{{ totalBills }}" max="{{ totalExpenses }}"></progress>
                    <div class="flex justify-between text-sm">
                        <span>Savings</span>
                        <span>${{ totalSavings|number_format(2) }}</span>
                    </div>
                    <progress class="progress progress-warning w-full"
                              value="{{ totalSavings }}" max="{{ totalExpenses }}"></progress>
                    <div class="flex justify-between text-sm">
                        <span>Spending</span>
                        <span>${{ totalSpending|number_format(2) }}</span>
                    </div>
                    <progress class="progress progress-info w-full"
                              value="{{ totalSpending }}" max="{{ totalExpenses }}"></progress>
                </div>
                <div class="flex justify-center">
                    <canvas id="expenseChart" class="max-h-48 max-w-48"></canvas>
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {# ── Income Section ── #}
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Monthly Income</h2>
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for income in incomes %}
                        <tr>
                            <td>{{ income.name }}</td>
                            <td>${{ income.amount.toFloat()|number_format(2) }}</td>
                            <td>
                                <form method="POST" action="{{ url_for('estimator.income.delete') }}" class="inline">
                                    <input type="hidden" name="id" value="{{ income.id }}">
                                    <button type="submit" class="btn btn-ghost btn-xs text-error">Remove</button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="text-center opacity-50 py-4">No income sources added</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <form method="POST" action="{{ url_for('estimator.income.store') }}"
                  class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end mt-2">
                <div class="form-control">
                    <label class="label"><span class="label-text">Source Name</span></label>
                    <input name="name" type="text" placeholder="e.g. Salary"
                           class="input input-bordered w-full" required />
                </div>
                <div class="form-control">
                    <label class="label"><span class="label-text">Monthly Amount</span></label>
                    <input name="amount" type="number" step="0.01" min="0.01" placeholder="0.00"
                           class="input input-bordered w-full" required />
                </div>
                <button type="submit" class="btn btn-primary">Add Income</button>
            </form>
        </div>
    </div>

    {# ── Expenses Section (Tabbed) ── #}
    <div id="expenses" class="card bg-base-100 shadow-xl"
         x-data="{ tab: new URLSearchParams(window.location.search).get('tab') || 'Bills' }">
        <div class="card-body">
            <h2 class="card-title">Monthly Expenses</h2>

            {# Tabs #}
            <div role="tablist" class="tabs tabs-bordered">
                <button role="tab" class="tab" :class="{ 'tab-active': tab === 'Bills' }"
                        @click="tab = 'Bills'">
                    Bills
                    {% if totalBills > 0 %}
                        <span class="badge badge-sm ml-1">${{ totalBills|number_format(0) }}</span>
                    {% endif %}
                </button>
                <button role="tab" class="tab" :class="{ 'tab-active': tab === 'Savings' }"
                        @click="tab = 'Savings'">
                    Savings
                    {% if totalSavings > 0 %}
                        <span class="badge badge-sm ml-1">${{ totalSavings|number_format(0) }}</span>
                    {% endif %}
                </button>
                <button role="tab" class="tab" :class="{ 'tab-active': tab === 'Spending' }"
                        @click="tab = 'Spending'">
                    Spending
                    {% if totalSpending > 0 %}
                        <span class="badge badge-sm ml-1">${{ totalSpending|number_format(0) }}</span>
                    {% endif %}
                </button>
            </div>

            {# Tab panels #}
            {% for cat in expenseCategories %}
            <div x-show="tab === '{{ cat.value }}'" x-transition>
                <div class="overflow-x-auto">
                    <table class="table table-zebra">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set hasItems = false %}
                            {% for expense in expenses %}
                                {% if expense.category.value == cat.value %}
                                {% set hasItems = true %}
                                <tr>
                                    <td>{{ expense.name }}</td>
                                    <td>${{ expense.amount.toFloat()|number_format(2) }}</td>
                                    <td>
                                        <form method="POST" action="{{ url_for('estimator.expense.delete') }}" class="inline">
                                            <input type="hidden" name="id" value="{{ expense.id }}">
                                            <input type="hidden" name="category" value="{{ cat.value }}">
                                            <button type="submit" class="btn btn-ghost btn-xs text-error">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                                {% endif %}
                            {% endfor %}
                            {% if not hasItems %}
                            <tr>
                                <td colspan="3" class="text-center opacity-50 py-4">
                                    No {{ cat.value|lower }} added
                                </td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                <form method="POST" action="{{ url_for('estimator.expense.store') }}"
                      class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end mt-2">
                    <input type="hidden" name="category" value="{{ cat.value }}">
                    <div class="form-control">
                        <label class="label"><span class="label-text">Name</span></label>
                        <input name="name" type="text"
                               placeholder="e.g. {{ cat.value == 'Bills' ? 'Rent' : (cat.value == 'Savings' ? 'Emergency Fund' : 'Groceries') }}"
                               class="input input-bordered w-full" required />
                    </div>
                    <div class="form-control">
                        <label class="label"><span class="label-text">Monthly Amount</span></label>
                        <input name="amount" type="number" step="0.01" min="0.01" placeholder="0.00"
                               class="input input-bordered w-full" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Add {{ cat.value }}</button>
                </form>
            </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
{% if totalExpenses > 0 %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    new Chart(document.getElementById('expenseChart'), {
        type: 'doughnut',
        data: {
            labels: ['Bills', 'Savings', 'Spending'],
            datasets: [{
                data: [{{ totalBills }}, {{ totalSavings }}, {{ totalSpending }}],
                backgroundColor: ['#f87171', '#facc15', '#60a5fa'],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });
});
</script>
{% endif %}
{% endblock %}
